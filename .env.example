# Submeta.AI — exemplo de variáveis de ambiente
# Não coloque valores reais neste arquivo.
# Configure os valores reais como GitHub Secrets e também no ambiente de produção.

# App
APP_ENV=development
APP_URL=http://localhost:3000

# Database / queue
DATABASE_URL=postgresql://user:password@localhost:5432/submeta_ai
REDIS_URL=redis://localhost:6379

# Security
EMAIL_HASH_SECRET=replace-with-strong-secret
ENCRYPTION_KEY=replace-with-strong-encryption-key
DOWNLOAD_TOKEN_SECRET=replace-with-strong-download-token-secret
WEBHOOK_SECRET=replace-with-strong-webhook-secret

# Limits
MAX_FILE_SIZE_MB=25
MAX_WORD_COUNT=12000
TEMP_ACTIVE_JOB_TTL_MINUTES=30
DELETE_AFTER_DOWNLOAD=true

# Internal free access
INTERNAL_FREE_ACCESS_ENABLED=true
INTERNAL_FREE_ACCESS_EMAIL_HASHES=replace-with-hmac-email-hash
INTERNAL_FREE_ACCESS_REQUIRE_EMAIL_CODE=true
INTERNAL_FREE_ACCESS_CODE_TTL_MINUTES=10
INTERNAL_FREE_ACCESS_PRODUCT=FULL_REPORT_WITH_ADJUSTED_VERSION

# Email provider
EMAIL_PROVIDER=resend
EMAIL_FROM=Submeta.AI <no-reply@submetaai.com.br>
RESEND_API_KEY=replace-with-resend-api-key
BREVO_API_KEY=
SENDGRID_API_KEY=

# Mercado Pago
PAYMENT_PROVIDER=mercado_pago
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_ACCESS_TOKEN=replace-with-mercado-pago-access-token
MERCADO_PAGO_PUBLIC_KEY=replace-with-mercado-pago-public-key
MERCADO_PAGO_WEBHOOK_SECRET=replace-with-mercado-pago-webhook-secret

# PayPal future / optional
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AI routing
FREE_PRECHECK_PROVIDER=mock
FREE_PRECHECK_MODEL=mock-free-precheck
FREE_PRECHECK_MAX_INPUT_CHARS=12000
PAID_ANALYSIS_PROVIDER=mock
PAID_ANALYSIS_MODEL=mock-paid-analysis
PAID_ADJUSTMENT_PROVIDER=mock
PAID_ADJUSTMENT_MODEL=mock-paid-adjustment
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Temporary storage
TEMP_STORAGE_PROVIDER=local
TEMP_STORAGE_BUCKET=
TEMP_STORAGE_ACCESS_KEY_ID=
TEMP_STORAGE_SECRET_ACCESS_KEY=
TEMP_STORAGE_ENDPOINT=

# Privacy / audit
LOG_MANUSCRIPT_CONTENT=false
LOG_PROMPTS_WITH_CONTENT=false
ALLOW_HUMAN_CONTENT_ACCESS=false
